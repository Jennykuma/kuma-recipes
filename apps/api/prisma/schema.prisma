// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          String   @id @default(uuid())
  userId      String
  title       String
  ingredients String[]
  notes       String?
  rating      Int?
  remake      Boolean? @default(false)
  steps       String[]
  source      String?
  imagePath   String?
  tags        Tag[]
  yield       String?
  shareLinks  RecipeShareLink[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  slug      String // normalized unique key for lookups + URL filters
  recipes   Recipe[]
  createdAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId, name])
}

model RecipeShareLink {
  id        String   @id @default(uuid())
  recipeId  String
  token     String   @unique
  revokedAt DateTime?
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}
