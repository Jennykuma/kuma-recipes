// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          String   @id @default(uuid())
  userId      String
  title       String
  ingredients String[]
  notes       String?
  rating      Int?
  steps       String[]
  source      String?
  imagePath   String?
  tags        Tag[]
  yield       String?
  shareLinks  RecipeShareLink[]
  variants    RecipeVariant[]
  attempts    RecipeAttempt[]
  pins        RecipePin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

model RecipeVariant {
  id          String   @id @default(uuid())
  recipeId    String
  name        String
  delta       Json?
  isBest      Boolean  @default(false)
  ingredients Json
  steps       Json
  order       Int
  attempts    RecipeAttempt[]
  pins        RecipePin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, order])
}

model RecipeAttempt {
  id        String   @id @default(uuid())
  recipeId  String
  variantId String?
  date      DateTime
  changes   String[]
  note      String?
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe  Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  variant RecipeVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([recipeId])
}

model RecipePin {
  id        String   @id @default(uuid())
  recipeId  String
  variantId String
  itemId    String?
  text      String
  color     String
  rotation  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe  Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  variant RecipeVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([variantId])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  slug      String // normalized unique key for lookups + URL filters
  recipes   Recipe[]
  createdAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId, name])
}

model RecipeShareLink {
  id        String   @id @default(uuid())
  recipeId  String
  token     String   @unique
  revokedAt DateTime?
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}
