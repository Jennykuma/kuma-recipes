{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/kuma-recipes",
      "destination": "/index.html"
    },
    {
      "source": "/kuma-recipes/api",
      "destination": "/api/proxy"
    },
    {
      "source": "/kuma-recipes/api/(.*)",
      "destination": "/api/proxy?route=$1"
    },
    {
      "source": "/kuma-recipes/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/kuma-recipes/(.*\\.(svg|png|jpg|jpeg|gif|webp|ico|txt|xml|json|webmanifest|woff|woff2|ttf|otf))",
      "destination": "/$1"
    },
    {
      "source": "/kuma-recipes/(.*)",
      "destination": "/index.html"
    }
  ]
}
