# App base path (must end with / when set).
# Use / for local dev at http://localhost:5173/
# Use /kuma-recipes/ when hosting at https://jennyle.dev/kuma-recipes
VITE_BASE_PATH=/

# API base URL.
# Keep /api if your host proxies /api -> api service.
# Or set full URL, e.g. https://api.jennyle.dev
VITE_API_BASE_URL=/api

# Clerk publishable key (frontend-safe key, starts with pk_).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Auto-logout after this many minutes without activity.
# Default in code is 10080 (7 days) when unset.
VITE_IDLE_LOGOUT_MINUTES=10080
